test-results/
playwright-report/

# Personal, machine-specific: permission allowlists and local overrides.
.claude/settings.local.json

# Downloaded VS Code builds for the extension integration tests (~300 MB).
.vscode-test/

# Yarn's own leavings: a crash log from a failed install, and a Berry install
# cache that this Yarn 1 repository never reads. Both arrived from upstream.
yarn-error.log
.yarn/

# The packaged extension. Built on demand and attached to a GitHub release —
# three and a half megabytes that would otherwise be committed by whoever ran
# `create:package` last. See docs/releasing.md.
*.vsix

# The MkDocs plugin's Python environment and caches, and the frame it vendors
# from packages/web/dist when a wheel is built (packages/mkdocs-dbml/README.md).
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
packages/mkdocs-dbml/src/mkdocs_dbml/_vendor/
