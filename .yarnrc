# Engine mismatches warn, as they do under npm, instead of stopping the install.
#
# A few dev dependencies of the VS Code and database packages ask for a newer
# Node than an install may run on (@vscode/test-cli and @azure/identity want
# 22, eslint-visitor-keys and yargs 20.19 or 22.13), and Yarn 1 treats that as
# fatal. On Node 20.11 an install stopped at @vscode/test-cli. Nothing here runs
# those packages at install time.
ignore-engines true
