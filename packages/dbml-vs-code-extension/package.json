{
  "name": "dbml-studio",
  "displayName": "DBML Studio",
  "description": "Diagram, import, and diff DBML schemas — ERD view, PostgreSQL import, live database compare.",
  "version": "1.2.1",
  "icon": "assets/logo.png",
  "publisher": "konyshevav",
  "license": "MIT",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "dbml",
    "erd",
    "entity relationship diagram",
    "database schema",
    "postgresql",
    "schema diff",
    "data model"
  ],
  "activationEvents": [],
  "main": "./dist/extension/index.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbmlStudio",
          "title": "%viewsContainer.title%",
          "icon": "assets/icons/panel.svg"
        }
      ]
    },
    "views": {
      "dbmlStudio": [
        {
          "id": "dbmlStudio.panel",
          "name": "DBML"
        }
      ]
    },
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml",
          "Database Markup Language"
        ],
        "extensions": [
          ".dbml"
        ],
        "icon": {
          "dark": "./icons/dbml-file.svg",
          "light": "./icons/dbml-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "dbml-studio-diagram",
        "displayName": "%customEditor.diagram%",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.dbml"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dbmlStudio.previewDiagrams",
        "title": "%command.previewDiagrams%",
        "icon": "$(open-preview)"
      },
      {
        "command": "dbmlStudio.previewDiagramsInPlace",
        "title": "%command.previewDiagramsInPlace%"
      },
      {
        "command": "dbmlStudio.showSource",
        "title": "%command.showSource%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dbmlStudio.importFromDatabase",
        "title": "%command.importFromDatabase%"
      },
      {
        "command": "dbmlStudio.compareWithDatabase",
        "title": "%command.compareWithDatabase%"
      },
      {
        "command": "dbmlStudio.addConnection",
        "title": "%command.addConnection%",
        "icon": "$(add)"
      },
      {
        "command": "dbmlStudio.refreshConnections",
        "title": "%command.refreshConnections%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbmlStudio.deleteConnection",
        "title": "%command.deleteConnection%",
        "icon": "$(trash)"
      },
      {
        "command": "dbmlStudio.importFromConnection",
        "title": "%command.importFromConnection%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dbmlStudio.compareWithConnection",
        "title": "%command.compareWithConnection%",
        "icon": "$(diff)"
      },
      {
        "command": "dbmlStudio.colorRelations",
        "title": "%command.colorRelations%"
      },
      {
        "command": "dbmlStudio.animateRelations",
        "title": "%command.animateRelations%"
      },
      {
        "command": "dbmlStudio.shortTableName",
        "title": "%command.shortTableName%"
      },
      {
        "command": "dbmlStudio.detailLevel",
        "title": "%command.detailLevel%"
      },
      {
        "command": "dbmlStudio.interactionMode",
        "title": "%command.interactionMode%"
      },
      {
        "command": "dbmlStudio.autoArrange",
        "title": "%command.autoArrange%"
      },
      {
        "command": "dbmlStudio.fitToView",
        "title": "%command.fitToView%"
      },
      {
        "command": "dbmlStudio.toggleTableRelations",
        "title": "%command.toggleTableRelations%"
      },
      {
        "command": "dbmlStudio.showAllTableRelations",
        "title": "%command.showAllTableRelations%"
      },
      {
        "command": "dbmlStudio.tableDetailLevel",
        "title": "%command.tableDetailLevel%"
      },
      {
        "command": "dbmlStudio.resetTableDetailLevels",
        "title": "%command.resetTableDetailLevels%"
      },
      {
        "command": "dbmlStudio.showShortcuts",
        "title": "%command.showShortcuts%"
      },
      {
        "command": "dbmlStudio.quickEdit",
        "title": "%command.quickEdit%"
      },
      {
        "command": "dbmlStudio.addColumn",
        "title": "%command.addColumn%"
      }
    ],
    "keybindings": [
      {
        "command": "dbmlStudio.colorRelations",
        "key": "c",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.animateRelations",
        "key": "a",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.shortTableName",
        "key": "s",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.detailLevel",
        "key": "d",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.interactionMode",
        "key": "v",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.autoArrange",
        "key": "l",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.fitToView",
        "key": "f",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.toggleTableRelations",
        "key": "h",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.showAllTableRelations",
        "key": "r",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.tableDetailLevel",
        "key": "t",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.resetTableDetailLevels",
        "key": "u",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.showShortcuts",
        "key": "shift+/",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.quickEdit",
        "key": "f2",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      },
      {
        "command": "dbmlStudio.addColumn",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "activeCustomEditorId == 'dbml-studio-diagram' && !inputFocus && !dbmlStudio.diagramInputFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dbmlStudio.importFromConnection",
          "when": "false"
        },
        {
          "command": "dbmlStudio.compareWithConnection",
          "when": "false"
        },
        {
          "command": "dbmlStudio.deleteConnection",
          "when": "false"
        },
        {
          "command": "dbmlStudio.colorRelations",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.animateRelations",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.shortTableName",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.detailLevel",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.interactionMode",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.autoArrange",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.fitToView",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.toggleTableRelations",
          "when": "false"
        },
        {
          "command": "dbmlStudio.showShortcuts",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.showAllTableRelations",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.tableDetailLevel",
          "when": "false"
        },
        {
          "command": "dbmlStudio.resetTableDetailLevels",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.quickEdit",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        },
        {
          "command": "dbmlStudio.addColumn",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'"
        }
      ],
      "editor/title": [
        {
          "command": "dbmlStudio.previewDiagrams",
          "when": "resourceLangId == dbml && activeCustomEditorId != 'dbml-studio-diagram'",
          "alt": "dbmlStudio.previewDiagramsInPlace",
          "group": "navigation"
        },
        {
          "command": "dbmlStudio.showSource",
          "when": "activeCustomEditorId == 'dbml-studio-diagram'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "dbmlStudio.addConnection",
          "when": "view == dbmlStudio.panel",
          "group": "navigation"
        },
        {
          "command": "dbmlStudio.refreshConnections",
          "when": "view == dbmlStudio.panel",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbmlStudio.importFromConnection",
          "when": "view == dbmlStudio.panel && viewItem == dbmlConnection",
          "group": "inline"
        },
        {
          "command": "dbmlStudio.compareWithConnection",
          "when": "view == dbmlStudio.panel && viewItem == dbmlConnection",
          "group": "inline"
        },
        {
          "command": "dbmlStudio.deleteConnection",
          "when": "view == dbmlStudio.panel && viewItem == dbmlConnection",
          "group": "inline"
        },
        {
          "command": "dbmlStudio.importFromConnection",
          "when": "view == dbmlStudio.panel && viewItem == dbmlDatabase",
          "group": "inline"
        },
        {
          "command": "dbmlStudio.compareWithConnection",
          "when": "view == dbmlStudio.panel && viewItem == dbmlDatabase",
          "group": "inline"
        },
        {
          "command": "dbmlStudio.importFromConnection",
          "when": "view == dbmlStudio.panel && viewItem == dbmlSchema",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dbmlStudio.preferredTheme": {
          "type": "string",
          "default": "dark",
          "enum": [
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "To use dark mode theme colors",
            "To use light mode theme colors"
          ]
        },
        "dbmlStudio.scrollDirection": {
          "type": "string",
          "default": "up-out",
          "enum": [
            "up-out",
            "up-in"
          ],
          "enumDescriptions": [
            "To zoom out when scrolling up",
            "To zoom in when scrolling up"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p tsconfig.tests.json",
    "watch-tests": "tsc -p tsconfig.tests.json -w",
    "pretest": "yarn run lint",
    "lint": "eslint extension --ext ts",
    "test": "jest",
    "test:integration": "yarn build && yarn compile-tests && vscode-test",
    "build": "npx vite build",
    "dev": "npx vite build --watch",
    "package": "yarn run build",
    "preview": "npx vite preview",
    "create:package": "vsce package",
    "publish": "vsce publish",
    "generate:css": "cd ../json-table-schema-visualizer && npx tailwindcss -i ./src/styles/index.css >  ../dbml-vs-code-extension/dist/webview/assets/index.css --minify"
  },
  "devDependencies": {
    "@tomjs/vite-plugin-vscode": "^2.2.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/react": "^18.2.75",
    "@types/react-dom": "^18.2.24",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.57.0",
    "playwright": "1.62.1",
    "ts-loader": "^9.5.1",
    "vite": "^5.2.8",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "dependencies": {
    "db-to-dbml": "0.0.0",
    "dbml-to-json-table-schema": "0.0.0",
    "extension-shared": "1.0.0",
    "json-table-schema-visualizer": "1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "schema-diff": "0.0.0",
    "shared": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AKonyshev/dbml-studio.git"
  },
  "homepage": "https://github.com/AKonyshev/dbml-studio#readme",
  "bugs": {
    "url": "https://github.com/AKonyshev/dbml-studio/issues"
  }
}
