{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["jest", "mocha", "node"],
    "paths": {
      "@/*": ["./*", "../json-table-schema-visualizer/src/*"],
      "dbml-mcp/*": ["../dbml-mcp/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "vite.config.mjs"],
  "include": ["**/*.ts", "**/*.tsx"]
}
