{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "rootDir": "./",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../json-table-schema-visualizer/src/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts", "**/*.tsx"]
}
