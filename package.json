  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "lerna": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "eslint-config-love": "155.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "node scripts/typecheck.js",
