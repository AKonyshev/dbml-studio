{
  "name": "db-schema-visualiser",
  "version": "0.0.3",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "lerna": "^8.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "node scripts/typecheck.js",
    "test": "node scripts/test.js",
    "publish:dbml": "bash scripts/publish-extension.sh dbml",
    "package:dbml": "bash scripts/publish-extension.sh dbml --package",
